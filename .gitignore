# ───────────────────────
#  ▸  Básico do Python
# ───────────────────────
__pycache__/
*.py[cod]
*$py.class

# Compiled Cython / C extensions
*.so
*.pyd
*.dll

# ───────────────────────
#  ▸  Ambientes virtuais
# ───────────────────────
# Se você colocar seus venvs dentro do repositório:
.out_process
.venv/
.win/
venv/
env/
ENV/

# Poetry
.poetry/

# Pipenv
Pipfile.lock

# Hatch
*.hatch/

# ───────────────────────
#  ▸  Dependências e artefatos de build
# ───────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/
*/.pytest_cache/

# ───────────────────────
#  ▸  Logs e relatórios
# ───────────────────────
*.log
*.coverage
coverage.xml
htmlcov/
logs

# ───────────────────────
