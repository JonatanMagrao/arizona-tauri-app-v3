# ───────────────────────
.tox/
.pytest_cache/
.nox/
.mypy_cache/
ruff_cache/
.pyre/

# ───────────────────────
#  ▸  Configs e segredos
# ───────────────────────
.env
.env.*
*.secret
*.key
*.pem

# ───────────────────────
