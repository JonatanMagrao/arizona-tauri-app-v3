{
  "name": "out-process-automation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "disable-cargo-config": "python scripts/handle_cargo_config.py disable",
    "enable-cargo-config": "python scripts/handle_cargo_config.py enable",
    "set:env": "python scripts/set_resources_mode.py",
    "embed-python": "python scripts/embed_python.py",
    "setup-cargo": "python scripts/setup_cargo_config.py",
    "python": "python src-tauri/src-python/main.py",
    "tauri:clean": "cd src-tauri && cargo clean",
    "tauri:dev": "npm run set:env dev && npm run disable-cargo-config && tauri dev",
    "tauri:build": "npm run set:env release && npm run embed-python && npm run enable-cargo-config && tauri build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2"
  }
}